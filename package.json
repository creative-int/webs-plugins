{
	"name": "@creative-int/webs-plugins",
	"version": "0.1.2",
	"private": true,
	"repoProfile": "agent-plugin-companion",
	"companionOf": "webs",
	"creativeInt": {
		"repoProfile": "agent-plugin-companion",
		"companionOf": "webs",
		"workspaceLint": {
			"allowedRootEntries": [
				"clients",
				"webs-connect.generated.ts",
				"webs.config.ts"
			]
		}
	},
	"description": "Webs MCP setup for Codex, Claude Code, Cursor, Windsurf, VS Code, generic clients, and Pi, plus the portable Webs memory skill pack.",
	"keywords": [
		"webs",
		"mcp",
		"memory",
		"agent-context",
		"recall",
		"research"
	],
	"homepage": "https://webs.creative-int.com",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/creative-int/webs-plugins.git"
	},
	"type": "module",
	"files": [
		".claude-plugin",
		".codex-plugin",
		".cursor-plugin",
		".mcp.json",
		"server.json",
		"LICENSE",
		"README.md",
		"assets/logo.png",
		"clients",
		"extensions",
		"skills",
		"webs.config.ts",
		"webs-connect.generated.ts"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"scripts": {
		"generate": "node tooling/generate.ts",
		"sync:webs-connect": "node tooling/sync-webs-connect.ts",
		"check:generated": "node tooling/generate.ts --check",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"build": "pnpm run typecheck",
		"test": "node --test test/*.test.ts",
		"battery": "node tooling/run-battery.ts --mode deterministic",
		"battery:requires-token": "node tooling/run-battery.ts --mode requires-token",
		"help": "node tooling/generate.ts --help && node tooling/smoke.ts --help && node tooling/run-battery.ts --help",
		"smoke": "node tooling/smoke.ts",
		"verify": "pnpm run check:generated && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run battery && pnpm run help && pnpm run smoke"
	},
	"dependencies": {
		"typebox": "1.3.6"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "0.80.10"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@creative-int/evals": "1.8.0",
		"@earendil-works/pi-coding-agent": "0.80.10",
		"@types/node": "^22.15.0",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=22 <23",
		"pnpm": ">=10.28.2"
	}
}
